{
  "manifest_version": 3,
  "name": "Gmail Quick Filters",
  "version": "1.0",
  "description": "Quick filter buttons in the Gmail header.",
  "permissions": ["storage"],
  "action": { "default_popup": "popup.html", "default_title": "Edit quick filters" },
  "content_scripts": [{ "matches": ["https://mail.google.com/*"], "js": ["content.js"] }]
}
